[Unit]
Description=clave hub (Claude Code with Remote Control and Telegram, in tmux)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/clave/bin/clave-hub
ExecStopPost=-/usr/bin/tmux kill-session -t clave
Restart=always
RestartSec=15
Environment=CLAVE_HOME=%h/clave
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
