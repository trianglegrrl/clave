#!/usr/bin/env bash
# Save one fact to clave's memory as its own file, and index it.
# Usage: clave-remember --name <slug> --type user|preference|fact|project|reference [--desc "one line"] "the fact"
#        echo "the fact" | clave-remember --name <slug> --type fact
# Re-using a name replaces that file (update, don't duplicate). Never put credentials in memory.
set -euo pipefail
CLAVE_HOME="${CLAVE_HOME:-$HOME/clave}"
DIR="$CLAVE_HOME/memory"
INDEX="$DIR/MEMORY.md"
NAME=""; TYPE="fact"; DESC=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) NAME="${2:-}"; shift 2 ;;
    --type) TYPE="${2:-}"; shift 2 ;;
    --desc) DESC="${2:-}"; shift 2 ;;
    -h|--help) sed -n 2,5p "$0"; exit 0 ;;
    *) break ;;
  esac
done
BODY="${*:-$(cat)}"
[[ -n "$NAME" ]] || { echo "clave-remember: --name <slug> is required" >&2; exit 1; }
[[ "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "clave-remember: name must be a lowercase kebab-case slug" >&2; exit 1; }
case "$TYPE" in user|preference|fact|project|reference) ;; *) echo "clave-remember: --type must be user, preference, fact, project, or reference" >&2; exit 1 ;; esac
[[ -n "$BODY" ]] || { echo "clave-remember: nothing to remember" >&2; exit 1; }
if grep -q -i -E '(api[_-]?key|password|token|secret)\s*[:=]' <<<"$BODY"; then
  echo "clave-remember: that looks like a credential; memory is not the place for it" >&2; exit 1
fi
[[ -n "$DESC" ]] || DESC="$(head -c 110 <<<"$BODY" | tr '\n' ' ')"
mkdir -p "$DIR"
FILE="$DIR/$NAME.md"
TODAY="$(date +%F)"
{
  printf -- '---\nname: %s\ndescription: %s\ntype: %s\nupdated: %s\n---\n\n%s\n' "$NAME" "$DESC" "$TYPE" "$TODAY" "$BODY"
} > "$FILE"
# Index: one line per memory; replace the line if the name already exists.
touch "$INDEX"
grep -v -F "]($NAME.md)" "$INDEX" > "$INDEX.tmp" || true
printf -- '- [%s](%s.md) — %s\n' "$NAME" "$NAME" "$DESC" >> "$INDEX.tmp"
mv "$INDEX.tmp" "$INDEX"
echo "remembered $NAME ($TYPE) -> memory/$NAME.md"
