#!/usr/bin/env bash
# Start (or reattach to) the clave hub: a Claude Code session in ~/clave with Remote Control,
# kept alive in tmux. On macOS the machine is also held awake; a Linux server needs no such thing.
set -euo pipefail
SESSION=clave
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"
command -v claude >/dev/null || { echo "claude not found on PATH (install: curl -fsSL https://claude.ai/install.sh | bash)" >&2; exit 1; }
# On Linux the hub is a systemd user service (systemd/clave.service) that restarts itself; just make sure it is up.
if [[ "$(uname)" == "Linux" ]] && systemctl --user list-unit-files clave.service >/dev/null 2>&1; then
  systemctl --user start clave.service
  echo "clave runs under systemd (status: systemctl --user status clave); attaching (detach with Ctrl-b d)"
  for _ in $(seq 1 30); do tmux has-session -t "$SESSION" 2>/dev/null && break; sleep 2; done
  exec tmux attach -t "$SESSION"
fi
if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "clave is already running; attaching (detach with Ctrl-b d)"; exec tmux attach -t "$SESSION"
fi
cd "${CLAVE_HOME:-$HOME/clave}"
KEEPAWAKE=""; [[ "$(uname)" == "Darwin" ]] && KEEPAWAKE="caffeinate -dims"
# Telegram channel (research preview) joins the session when the plugin has been configured.
CHANNELS=""; [[ -f "$HOME/.claude/channels/telegram/.env" ]] && CHANNELS="--channels plugin:telegram@claude-plugins-official"
exec tmux new -s "$SESSION" "$KEEPAWAKE claude --remote-control $CHANNELS"
