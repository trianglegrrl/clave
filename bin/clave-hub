#!/usr/bin/env bash
# Foreground supervisor for the clave hub, meant to run under systemd (see systemd/clave.service).
# Starts Claude Code in a tmux session, enters the inbox loop once the session is ready, then
# watches it: if the session dies, or a chat channel subprocess (Telegram, Slack) disappears, exit so
# systemd restarts everything. Attach any time with: tmux attach -t clave
set -euo pipefail
SESSION=clave
CLAVE_HOME="${CLAVE_HOME:-$HOME/clave}"
LOOP_PROMPT="/loop 1h read LOOP.md and process the event inbox"
READY_TIMEOUT=120      # seconds to wait for Remote Control to come up
CHANNEL_GRACE=3        # consecutive checks without a channel process before restarting
CHECK_EVERY=30         # seconds between health checks
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

log() { printf '%s clave-hub: %s\n' "$(date '+%F %T')" "$*"; }
command -v claude >/dev/null || { log "claude not found on PATH"; exit 1; }
command -v tmux >/dev/null || { log "tmux not found"; exit 1; }

TELEGRAM_PATTERN="^bun run --cwd .*claude-plugins-official/telegram"
SLACK_PATTERN="bun $CLAVE_HOME/channel/slack-channel[.]ts"   # absolute path, so Belvedere's ./channel copy never matches
CHANNELS=""; WATCH=()
if [[ -f "$HOME/.claude/channels/telegram/.env" ]]; then
  CHANNELS="--channels plugin:telegram@claude-plugins-official"; WATCH+=("$TELEGRAM_PATTERN")
fi
# Slack (#clave) is a custom channel, so it loads as a development channel (see channel/slack-channel.ts).
if [[ -f "$CLAVE_HOME/.env" && -d "$CLAVE_HOME/channel/node_modules" ]]; then
  CHANNELS="$CHANNELS --dangerously-load-development-channels server:slack"; WATCH+=("$SLACK_PATTERN")
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
  log "stale session found; killing it"; tmux kill-session -t "$SESSION" || true; sleep 2
fi
# A killed hub can leave its Telegram poller behind; two pollers on one bot steal each other's messages.
# Same for Slack: two Socket Mode connections split incoming messages between them.
for pat in "$TELEGRAM_PATTERN" "$SLACK_PATTERN"; do
  if pgrep -u "$USER" -f "$pat" >/dev/null; then
    log "killing orphaned channel process(es): $pat"; pkill -u "$USER" -f "$pat" || true; sleep 1
  fi
done

cd "$CLAVE_HOME"
tmux new -d -s "$SESSION" -x 200 -y 50 "claude --remote-control $CHANNELS"
log "started tmux session $SESSION"

pane() { tmux capture-pane -p -t "$SESSION" -S -60 2>/dev/null || true; }
pane_pid() { tmux list-panes -t "$SESSION" -F '#{pane_pid}' 2>/dev/null | head -1; }
descends_from() {  # descends_from <pid> <ancestor>: is <ancestor> somewhere up <pid>'s parent chain?
  local p=$1 anc=$2
  while [[ -n "$p" && "$p" -gt 1 ]]; do
    [[ "$p" == "$anc" ]] && return 0
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
  return 1
}
proc_alive() {  # proc_alive <pattern>: is a matching process running under this session's pane?
  local root p; root=$(pane_pid) || return 1
  [[ -n "$root" ]] || return 1
  for p in $(pgrep -u "$USER" -f "$1"); do
    descends_from "$p" "$root" && return 0
  done
  return 1
}
channel_alive() {  # every configured channel must be up (none configured: nothing to watch)
  local pat
  for pat in "${WATCH[@]}"; do proc_alive "$pat" || return 1; done
  return 0
}

# Wait for the session to be ready, then enter the polling loop.
deadline=$(( $(date +%s) + READY_TIMEOUT ))
until pane | grep -q "remote-control is active"; do
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then log "session died during startup"; exit 1; fi
  # The development-channel warning returns on every launch; accept it so restarts stay unattended.
  if pane | grep -q "WARNING: Loading development channels"; then
    log "accepting development-channel warning"; tmux send-keys -t "$SESSION" Enter; sleep 5
  fi
  if (( $(date +%s) > deadline )); then log "Remote Control not ready after ${READY_TIMEOUT}s; restarting"; tmux kill-session -t "$SESSION" || true; exit 1; fi
  sleep 3
done
sleep 5
tmux send-keys -t "$SESSION" "$LOOP_PROMPT" Enter
log "ready; loop prompt sent"

# Supervise.
missing=0
while sleep "$CHECK_EVERY"; do
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then log "session gone; exiting for restart"; exit 1; fi
  if channel_alive; then
    missing=0
  else
    missing=$((missing + 1)); log "channel process missing ($missing/$CHANNEL_GRACE)"
    if (( missing >= CHANNEL_GRACE )); then
      log "channel stayed dead; restarting hub"; tmux kill-session -t "$SESSION" || true; exit 1
    fi
  fi
done
